generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SenderType {
  USER
  ADMIN
}

enum NotificationType {
  NEW_MESSAGE
  MESSAGE_REPLY
  BROADCAST
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  image     String?
  password  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  emailVerified Boolean @default(false)
  verificationToken String?
  verificationTokenExpiry DateTime?
  resetToken String?
  resetTokenExpiry DateTime?
  phone     String?
  whatsapp  String?
  address   String?

  bookings     Booking[]
  reviews      Review[]
  wishlists    Wishlist[]
  messages     Message[]
  notifications Notification[]
}

model Tour {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  shortDesc String
  description String
  highlights Json
  included  Json
  notIncluded Json
  itinerary Json?
  translations Json
  price     Float
  childPrice Float?
  discountPrice Float?
  duration  String
  location  String
  category  String
  images    Json
  maxCapacity Int
  isActive  Boolean  @default(true)
  isFeatured Boolean @default(false)
  isBestseller Boolean @default(false)
  hasFreeCancellation Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]
  reviews   Review[]
  wishlists Wishlist[]
}

model Booking {
  id            String        @id @default(uuid())
  userId        String?
  tourId        String
  tourDate      DateTime
  people        Int
  totalPrice    Float
  status        BookingStatus @default(PENDING)
  contactName   String
  contactEmail  String
  contactPhone  String
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id])
  tour Tour @relation(fields: [tourId], references: [id])
}

model Review {
  id         String       @id @default(uuid())
  userId     String?
  tourId     String
  rating     Int
  comment    String
  status     ReviewStatus @default(PENDING)
  adminReply String?
  createdAt  DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id])
  tour Tour @relation(fields: [tourId], references: [id])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  tourId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  tour Tour @relation(fields: [tourId], references: [id])

  @@unique([userId, tourId])
}

model Message {
  id            String      @id @default(uuid())
  userId        String
  subject       String?
  content       String
  senderType    SenderType
  isRead        Boolean     @default(false)
  isReadByAdmin Boolean     @default(false)
  replyToId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  replyTo  Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies Message[] @relation("MessageReplies")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}